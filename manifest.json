{
   "manifest_version": 3,
   "name": "PureWatch",
   "version": "1.0.0",
   "description": "Automatically skip sponsor segments in YouTube videos",
   "permissions": [
      "storage"
   ],
   "content_scripts": [
      {
         "matches": ["https://www.youtube.com/*"],
         "js": ["content.js"]
      }
   ],
   "background": {
      "service_worker": "background.js"
   }
}
